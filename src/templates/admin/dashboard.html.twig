{% extends '@EasyAdmin/page/content.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <style>
        /* ===== DASHBOARD THEME ===== */
        .ea-dashboard-content {
            position: relative;
        }
        /* Grain overlay — dark mode only */
        [data-bs-theme="dark"] .ea-dashboard-content::before {
            content: '';
            position: fixed;
            inset: -200%;
            width: 400%;
            height: 400%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            animation: eaGrain 8s steps(10) infinite;
            opacity: 0.3;
        }
        @keyframes eaGrain {
            0%, 100% { transform: translate(0, 0); }
            10% { transform: translate(-5%, -10%); }
            20% { transform: translate(-15%, 5%); }
            30% { transform: translate(7%, -25%); }
            40% { transform: translate(-5%, 25%); }
            50% { transform: translate(-15%, 10%); }
            60% { transform: translate(15%, 0%); }
            70% { transform: translate(0%, 15%); }
            80% { transform: translate(3%, 35%); }
            90% { transform: translate(-10%, 10%); }
        }

        /* ===== DASHBOARD STYLES ===== */
        .dashboard-wrapper {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
            position: relative;
            z-index: 1;
        }

        /* Header */
        .dashboard-header {
            background: var(--admin-surface);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }
        [data-bs-theme="dark"] .dashboard-header {
            background: var(--admin-surface);
            backdrop-filter: blur(20px);
        }
        .dashboard-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--admin-accent-soft), transparent);
        }

        .dashboard-title {
            font-family: 'Syne', system-ui, sans-serif;
            font-size: 28px;
            font-weight: 800;
            color: var(--admin-text);
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 6px 0;
            letter-spacing: -0.02em;
        }
        .dashboard-title .icon {
            width: 32px;
            height: 32px;
            color: var(--admin-accent);
        }
        .dashboard-subtitle {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 14px;
            color: var(--admin-text-dim);
            margin: 0;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }
        @media (min-width: 640px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (min-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(4, 1fr); }
        }

        /* Stat Card */
        .stat-card {
            background: var(--admin-surface);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            padding: 22px;
            display: flex;
            gap: 16px;
            align-items: flex-start;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 0;
            background: linear-gradient(135deg, var(--admin-accent-soft), transparent);
            transition: height 0.4s ease;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            border-color: var(--admin-accent-soft);
            box-shadow: 0 20px 40px var(--admin-shadow), 0 0 20px var(--admin-accent-soft);
        }
        .stat-card:hover::after {
            height: 100%;
        }

        .stat-card__icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }
        .stat-card__icon svg {
            width: 22px;
            height: 22px;
        }

        .stat-card--revenue .stat-card__icon {
            background: var(--admin-accent-soft);
            color: var(--admin-accent);
            border: 1px solid var(--admin-accent-soft);
        }
        .stat-card--orders .stat-card__icon {
            background: var(--admin-color-info-bg);
            color: var(--admin-color-info);
            border: 1px solid var(--admin-color-info-bg);
        }
        .stat-card--average .stat-card__icon {
            background: var(--admin-color-purple-bg);
            color: var(--admin-color-purple);
            border: 1px solid var(--admin-color-purple-bg);
        }
        .stat-card--products .stat-card__icon {
            background: var(--admin-color-warning-bg);
            color: var(--admin-color-warning);
            border: 1px solid var(--admin-color-warning-bg);
        }

        .stat-card__content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            position: relative;
            z-index: 1;
        }
        .stat-card__label {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 12px;
            color: var(--admin-text-muted);
            font-weight: 500;
        }
        .stat-card__value {
            font-family: 'Syne', system-ui, sans-serif;
            font-size: 26px;
            font-weight: 800;
            color: var(--admin-text);
            line-height: 1.2;
            letter-spacing: -0.02em;
        }
        .stat-card__change {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            margin-top: 2px;
        }
        .stat-card__change svg {
            width: 14px;
            height: 14px;
        }
        .stat-card__change--positive { color: var(--admin-accent); }
        .stat-card__change--negative { color: var(--admin-color-danger); }
        .stat-card__change--neutral { color: var(--admin-text-dim); }

        /* Dashboard Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        @media (min-width: 1024px) {
            .dashboard-grid { grid-template-columns: 2fr 1fr; }
        }

        /* Cards */
        .dashboard-card {
            background: var(--admin-surface);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            overflow: hidden;
            transition: border-color 0.3s;
        }
        .dashboard-card:hover {
            border-color: var(--admin-border);
        }

        .dashboard-card__header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .dashboard-card__title {
            font-family: 'Syne', system-ui, sans-serif;
            font-size: 16px;
            font-weight: 700;
            color: var(--admin-text);
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            letter-spacing: -0.01em;
        }
        .dashboard-card__title svg {
            width: 18px;
            height: 18px;
            color: var(--admin-accent);
        }
        .dashboard-card__subtitle {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 12px;
            color: var(--admin-text-dim);
        }
        .dashboard-card__content {
            padding: 24px;
        }

        /* Chart */
        #salesChart {
            max-height: 300px;
        }

        /* Top Products */
        .top-products {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .top-product {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            background: var(--admin-header-bg);
            border: 1px solid var(--admin-row-border);
            border-radius: 12px;
            transition: all 0.3s;
        }
        .top-product:hover {
            background: var(--admin-surface-hover);
            border-color: var(--admin-accent-soft);
        }
        .top-product__rank {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: var(--admin-accent);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', system-ui, sans-serif;
            font-weight: 800;
            font-size: 13px;
            flex-shrink: 0;
        }
        .top-product__info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }
        .top-product__name {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-weight: 600;
            color: var(--admin-text);
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .top-product__qty {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 11px;
            color: var(--admin-text-dim);
        }
        .top-product__revenue {
            font-family: 'Syne', system-ui, sans-serif;
            font-weight: 700;
            color: var(--admin-accent);
            font-size: 14px;
            white-space: nowrap;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--admin-text-dim);
        }
        .empty-state svg {
            width: 48px;
            height: 48px;
            margin-bottom: 16px;
            color: var(--admin-text-dim);
        }
        .empty-state p {
            margin: 0;
            font-size: 14px;
            color: var(--admin-text-dim);
        }

        /* Status Grid */
        .status-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        @media (min-width: 640px) {
            .status-grid { grid-template-columns: repeat(3, 1fr); }
        }
        @media (min-width: 768px) {
            .status-grid { grid-template-columns: repeat(6, 1fr); }
        }

        .status-item {
            text-align: center;
            padding: 18px 12px;
            background: var(--admin-header-bg);
            border: 1px solid var(--admin-row-border);
            border-radius: 12px;
            transition: all 0.3s;
        }
        .status-item:hover {
            transform: translateY(-3px);
            background: var(--admin-surface-hover);
            border-color: var(--admin-border);
        }
        .status-item__count {
            display: block;
            font-family: 'Syne', system-ui, sans-serif;
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 4px;
            letter-spacing: -0.02em;
        }
        .status-item__label {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 11px;
            color: var(--admin-text-dim);
            text-transform: capitalize;
        }

        .status-item--pending .status-item__count { color: var(--admin-color-warning); }
        .status-item--paid .status-item__count { color: var(--admin-color-info); }
        .status-item--confirmed .status-item__count { color: var(--admin-color-purple); }
        .status-item--shipped .status-item__count { color: var(--admin-color-cyan); }
        .status-item--delivered .status-item__count { color: var(--admin-accent); }
        .status-item--cancelled .status-item__count { color: var(--admin-color-danger); }

        /* Animate in */
        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-card {
            animation: fadeSlideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }
        .animate-card:nth-child(1) { animation-delay: 0s; }
        .animate-card:nth-child(2) { animation-delay: 0.1s; }
        .animate-card:nth-child(3) { animation-delay: 0.2s; }
        .animate-card:nth-child(4) { animation-delay: 0.3s; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--admin-scrollbar-track); }
        ::-webkit-scrollbar-thumb { background: var(--admin-scrollbar-thumb); border-radius: 3px; }

        /* Selection */
        ::selection { background: var(--admin-accent-soft); color: var(--admin-text); }
    </style>

    <div class="ea-dashboard-content">
        <div class="dashboard-wrapper">
            {# Header #}
            <header class="dashboard-header">
                <h1 class="dashboard-title">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                    Панель управления
                </h1>
                <p class="dashboard-subtitle">Обзор продаж и статистики</p>
            </header>

            {# Stats #}
            <div class="stats-grid">
                <div class="stat-card stat-card--revenue animate-card">
                    <div class="stat-card__icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="stat-card__content">
                        <span class="stat-card__label">Выручка за сегодня</span>
                        <span class="stat-card__value">{{ stats.todayRevenue|number_format(0, '.', ' ') }} ₽</span>
                        {% if stats.todayRevenueChange > 0 %}
                            <span class="stat-card__change stat-card__change--positive">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                                +{{ stats.todayRevenueChange }}%
                            </span>
                        {% elseif stats.todayRevenueChange < 0 %}
                            <span class="stat-card__change stat-card__change--negative">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
                                {{ stats.todayRevenueChange }}%
                            </span>
                        {% else %}
                            <span class="stat-card__change stat-card__change--neutral">Без изменений</span>
                        {% endif %}
                    </div>
                </div>

                <div class="stat-card stat-card--orders animate-card">
                    <div class="stat-card__icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                    </div>
                    <div class="stat-card__content">
                        <span class="stat-card__label">Новые заказы</span>
                        <span class="stat-card__value">{{ stats.todayOrders }}</span>
                        {% if stats.todayOrdersChange > 0 %}
                            <span class="stat-card__change stat-card__change--positive">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                                +{{ stats.todayOrdersChange }}%
                            </span>
                        {% elseif stats.todayOrdersChange < 0 %}
                            <span class="stat-card__change stat-card__change--negative">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
                                {{ stats.todayOrdersChange }}%
                            </span>
                        {% else %}
                            <span class="stat-card__change stat-card__change--neutral">Без изменений</span>
                        {% endif %}
                    </div>
                </div>

                <div class="stat-card stat-card--average animate-card">
                    <div class="stat-card__icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div class="stat-card__content">
                        <span class="stat-card__label">Средний чек</span>
                        <span class="stat-card__value">{{ stats.averageCheck|number_format(0, '.', ' ') }} ₽</span>
                        <span class="stat-card__change stat-card__change--neutral">за сегодня</span>
                    </div>
                </div>

                <div class="stat-card stat-card--products animate-card">
                    <div class="stat-card__icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                    </div>
                    <div class="stat-card__content">
                        <span class="stat-card__label">Выручка за неделю</span>
                        <span class="stat-card__value">{{ stats.weekRevenue|number_format(0, '.', ' ') }} ₽</span>
                        <span class="stat-card__change stat-card__change--neutral">{{ stats.monthRevenue|number_format(0, '.', ' ') }} ₽ за месяц</span>
                    </div>
                </div>
            </div>

            {# Chart + Top Products #}
            <div class="dashboard-grid">
                <div class="dashboard-card">
                    <div class="dashboard-card__header">
                        <h2 class="dashboard-card__title">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
                            </svg>
                            Динамика продаж
                        </h2>
                        <span class="dashboard-card__subtitle">за последние 7 дней</span>
                    </div>
                    <div class="dashboard-card__content">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="dashboard-card__header">
                        <h2 class="dashboard-card__title">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                            </svg>
                            Топ товаров
                        </h2>
                        <span class="dashboard-card__subtitle">по продажам</span>
                    </div>
                    <div class="dashboard-card__content">
                        {% if topProducts|length > 0 %}
                            <div class="top-products">
                                {% for product in topProducts %}
                                    <div class="top-product">
                                        <div class="top-product__rank">{{ loop.index }}</div>
                                        <div class="top-product__info">
                                            <span class="top-product__name">{{ product.name }}</span>
                                            <span class="top-product__qty">{{ product.quantity }} шт.</span>
                                        </div>
                                        <div class="top-product__revenue">{{ product.revenue|number_format(0, '.', ' ') }} ₽</div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                </svg>
                                <p>Нет продаж за период</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Order Statuses #}
            <div class="dashboard-card">
                <div class="dashboard-card__header">
                    <h2 class="dashboard-card__title">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Статусы заказов
                    </h2>
                </div>
                <div class="dashboard-card__content">
                    <div class="status-grid">
                        {% for status in orderStatuses %}
                            <div class="status-item status-item--{{ status.status }}">
                                <span class="status-item__count">{{ status.count }}</span>
                                <span class="status-item__label">{{ status.status|replace({'_': ' '})|title }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Chart.js #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const salesData = {{ salesChart|json_encode|raw }};
        const dates = salesData.map(item => item.date);
        const revenues = salesData.map(item => item.revenue);
        const orders = salesData.map(item => item.orders);

        // Read CSS variables for chart colors
        const cs = getComputedStyle(document.documentElement);
        const accent = cs.getPropertyValue('--admin-accent').trim();
        const accentSoft = cs.getPropertyValue('--admin-accent-soft').trim();
        const textMuted = cs.getPropertyValue('--admin-text-muted').trim();
        const textDim = cs.getPropertyValue('--admin-text-dim').trim();
        const text = cs.getPropertyValue('--admin-text').trim();
        const bg = cs.getPropertyValue('--admin-bg').trim();
        const border = cs.getPropertyValue('--admin-border').trim();
        const info = cs.getPropertyValue('--admin-color-info').trim();

        const ctx = document.getElementById('salesChart').getContext('2d');

        // Gradient for revenue
        const revenueGradient = ctx.createLinearGradient(0, 0, 0, 300);
        revenueGradient.addColorStop(0, accentSoft || 'rgba(22, 163, 74, 0.15)');
        revenueGradient.addColorStop(1, 'transparent');

        // Gradient for orders
        const ordersGradient = ctx.createLinearGradient(0, 0, 0, 300);
        ordersGradient.addColorStop(0, (info ? info + '1a' : 'rgba(96, 165, 250, 0.1)'));
        ordersGradient.addColorStop(1, 'transparent');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: dates,
                datasets: [
                    {
                        label: 'Выручка (₽)',
                        data: revenues,
                        borderColor: accent,
                        backgroundColor: revenueGradient,
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: accent,
                        pointBorderColor: bg,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Заказы',
                        data: orders,
                        borderColor: info,
                        backgroundColor: ordersGradient,
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: info,
                        pointBorderColor: bg,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                aspectRatio: 2,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            color: textMuted,
                            font: { family: 'DM Sans', size: 12 },
                            padding: 16,
                            usePointStyle: true,
                            pointStyleWidth: 8
                        }
                    },
                    tooltip: {
                        backgroundColor: bg,
                        padding: 12,
                        titleFont: { family: 'Syne', size: 13, weight: '700' },
                        bodyFont: { family: 'DM Sans', size: 12 },
                        titleColor: text,
                        bodyColor: textMuted,
                        borderColor: border,
                        borderWidth: 1,
                        cornerRadius: 10,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) label += ': ';
                                if (context.parsed.y !== null) {
                                    label += context.parsed.y.toLocaleString('ru-RU');
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        grid: {
                            color: border,
                            drawBorder: false
                        },
                        ticks: {
                            color: textDim,
                            font: { family: 'DM Sans', size: 11 },
                            callback: function(value) {
                                return value.toLocaleString('ru-RU') + ' ₽';
                            }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: {
                            drawOnChartArea: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: textDim,
                            font: { family: 'DM Sans', size: 11 }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: textDim,
                            font: { family: 'DM Sans', size: 11 }
                        }
                    }
                }
            }
        });
    </script>
{% endblock %}
