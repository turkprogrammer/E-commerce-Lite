<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}E-commerce Premium{% endblock %}</title>

    {# TailwindCSS #}
    <script src="https://cdn.tailwindcss.com"></script>

    {# Premium Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {# Tailwind Config #}
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter Tight', 'system-ui', 'sans-serif'],
                        display: ['Space Grotesk', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        charcoal: {
                            50: '#fafafa',
                            100: '#f4f4f5',
                            200: '#e4e4e7',
                            300: '#d4d4d8',
                            400: '#a1a1aa',
                            500: '#71717a',
                            600: '#52525b',
                            700: '#3f3f46',
                            800: '#27272a',
                            900: '#18181b',
                            950: '#09090b',
                        },
                        lime: {
                            50: '#f7ffe5',
                            100: '#ecffb8',
                            200: '#d9ff8b',
                            300: '#bfff59',
                            400: '#a3ff33',
                            500: '#88ff0d',
                            600: '#66cc00',
                            700: '#4d9900',
                            800: '#3d7a00',
                            900: '#336600',
                        },
                        neutral: {
                            50: '#fafafa',
                            100: '#f5f5f5',
                            200: '#e5e5e5',
                            300: '#d4d4d4',
                            400: '#a3a3a3',
                            500: '#737373',
                            600: '#525252',
                            700: '#404040',
                            800: '#262626',
                            900: '#171717',
                            950: '#0a0a0a',
                        }
                    },
                    animation: {
                        'float': 'float 8s ease-in-out infinite',
                        'float-delayed': 'float 8s ease-in-out 4s infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'fade-in': 'fadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1)',
                        'slide-up': 'slideUp 0.8s cubic-bezier(0.4, 0, 0.2, 1)',
                        'scale-in': 'scaleIn 0.6s cubic-bezier(0.4, 0, 0.2, 1)',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(40px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        scaleIn: {
                            '0%': { opacity: '0', transform: 'scale(0.9)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        },
                    },
                    backdropBlur: {
                        xs: '2px',
                    },
                    boxShadow: {
                        'neon': '0 0 20px rgba(136, 255, 13, 0.3), 0 0 40px rgba(136, 255, 13, 0.1)',
                        'neon-hover': '0 0 30px rgba(136, 255, 13, 0.5), 0 0 60px rgba(136, 255, 13, 0.2)',
                        'deep': '0 25px 50px -12px rgba(0, 0, 0, 0.5)',
                        'glass': '0 8px 32px rgba(0, 0, 0, 0.3)',
                    }
                }
            }
        }
    </script>

    {# Premium Styles #}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter Tight', system-ui, sans-serif;
            background: #0a0a0a;
            color: #fafafa;
            overflow-x: hidden;
        }

        /* Cinematic Gradient Background */
        .cinematic-bg {
            background: 
                radial-gradient(ellipse at 20% 20%, rgba(136, 255, 13, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 80%, rgba(136, 255, 13, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(24, 24, 27, 0.8) 0%, #0a0a0a 100%);
            background-attachment: fixed;
        }

        /* Frosted Glass */
        .frosted-glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .frosted-glass-dark {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Premium Card */
        .premium-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .premium-card:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.03) 100%);
            border-color: rgba(136, 255, 13, 0.3);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 30px rgba(136, 255, 13, 0.1);
            transform: translateY(-8px);
        }

        /* Neon Glow Button */
        .neon-button {
            background: linear-gradient(135deg, #88ff0d 0%, #66cc00 100%);
            color: #0a0a0a;
            font-weight: 700;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 20px rgba(136, 255, 13, 0.3);
        }

        .neon-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 40px rgba(136, 255, 13, 0.5), 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Text Gradient */
        .text-gradient {
            background: linear-gradient(135deg, #fafafa 0%, #a1a1aa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .text-gradient-lime {
            background: linear-gradient(135deg, #ccff00 0%, #88ff0d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Grid Pattern */
        .grid-pattern {
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* Glow Orbs */
        .glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            animation: float 8s ease-in-out infinite;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #88ff0d, #66cc00);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #ccff00, #88ff0d);
        }

        /* Selection */
        ::selection {
            background: rgba(136, 255, 13, 0.3);
            color: #fafafa;
        }

        /* Image Loading */
        .image-loading {
            background: linear-gradient(90deg, #1a1a1a 0%, #2d2d2d 50%, #1a1a1a 100%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }

        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* 3D Transform */
        .card-3d {
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }

        .card-3d:hover {
            transform: perspective(1000px) rotateX(5deg) rotateY(-5deg) translateZ(10px);
        }

        /* Filter Buttons */
        .filter-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            color: #a1a1aa;
        }
        .filter-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(136, 255, 13, 0.3);
            color: #fff;
        }
        .filter-btn.active {
            background: linear-gradient(135deg, #88ff0d 0%, #66cc00 100%);
            border-color: transparent;
            color: #0a0a0a;
            font-weight: 700;
            box-shadow: 0 0 20px rgba(136, 255, 13, 0.3);
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            pointer-events: none;
        }
        .toast {
            pointer-events: auto;
            background: rgba(10, 10, 10, 0.95);
            border: 1px solid rgba(136, 255, 13, 0.3);
            backdrop-filter: blur(20px);
            color: #fafafa;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 20px rgba(136, 255, 13, 0.1);
            transform: translateX(120%);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 280px;
        }
        .toast.show {
            transform: translateX(0);
            opacity: 1;
        }
        .toast.success { border-color: rgba(136, 255, 13, 0.5); }
        .toast.error { border-color: rgba(239, 68, 68, 0.5); }

        /* Quantity buttons in cart */
        .qty-btn {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.5rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            transition: all 0.2s;
            cursor: pointer;
        }
        .qty-btn:hover {
            background: rgba(136, 255, 13, 0.15);
            border-color: rgba(136, 255, 13, 0.4);
        }
        .qty-btn:active { transform: scale(0.92); }

        /* Loader */
        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(10,10,10,0.2);
            border-top-color: #0a0a0a;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Checkout modal backdrop */
        .modal-backdrop {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
        }

        /* Input focus styles */
        .premium-input:focus {
            outline: none;
            border-color: rgba(136, 255, 13, 0.5);
            box-shadow: 0 0 0 3px rgba(136, 255, 13, 0.1);
        }

        /* Success checkmark animation */
        .checkmark-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #88ff0d 0%, #66cc00 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            animation: scaleIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .checkmark-circle svg {
            width: 40px;
            height: 40px;
            color: #0a0a0a;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="cinematic-bg antialiased">
    {# Background Glow Orbs #}
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="glow-orb w-96 h-96 bg-lime-500 top-0 left-1/4"></div>
        <div class="glow-orb w-80 h-80 bg-lime-600 bottom-0 right-1/4 animation-float-delayed"></div>
    </div>

    {% block body %}{% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
