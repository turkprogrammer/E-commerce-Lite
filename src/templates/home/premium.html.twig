{% extends 'base.html.twig' %}

{% block title %}E-commerce Lite — Premium Store{% endblock %}

{% block body %}
    {# Header #}
    <header class="sticky top-0 z-50 frosted-glass-dark border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <a href="/" class="flex items-center space-x-2">
                    <div class="w-10 h-10 bg-lime-500 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-black" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                    </div>
                    <span class="text-xl font-bold text-white tracking-tighter">ECOMMERCE</span>
                </a>
                <nav class="hidden md:flex items-center space-x-8 text-gray-400">
                    <a href="#collection" class="text-sm font-medium hover:text-white transition-colors">Каталог</a>
                    <a href="#about" class="text-sm font-medium hover:text-white transition-colors">О нас</a>
                    <a href="#contact" class="text-sm font-medium hover:text-white transition-colors">Контакты</a>
                </nav>
                <button id="cart-button" onclick="toggleCart()" class="relative p-2 hover:bg-white/5 rounded-lg text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    <span id="cart-count" class="absolute -top-1 -right-1 bg-lime-500 text-black text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center opacity-0 transition-opacity">0</span>
                </button>
            </div>
        </div>
    </header>

    {# Hero #}
    <section class="py-20 lg:py-32 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-5xl md:text-7xl font-black text-white mb-6 font-display animate-slide-up">
                Latest <span class="text-gradient-lime">Drops</span>
            </h1>
            <p class="text-gray-400 text-xl max-w-2xl mx-auto animate-slide-up" style="animation-delay:0.15s">
                Exclusive pieces, limited availability
            </p>
        </div>
    </section>

    {# Filters & Search #}
    <section class="pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div id="category-filters" class="flex flex-wrap gap-2">
                    <button class="filter-btn active px-5 py-2 rounded-full text-sm font-medium" data-category="all">Все</button>
                </div>
                <div class="relative w-full md:w-72">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <input id="search-input" type="text" placeholder="Поиск товаров..." class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-gray-500 text-sm premium-input transition-all">
                </div>
            </div>
        </div>
    </section>

    {# Products #}
    <section id="collection" class="pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="skeleton rounded-3xl h-96"></div>
                <div class="skeleton rounded-3xl h-96"></div>
                <div class="skeleton rounded-3xl h-96"></div>
            </div>

            <div id="load-more-container" class="text-center mt-16 hidden">
                <button id="load-more-btn" class="neon-button py-4 px-10 rounded-full text-lg shadow-neon hover:shadow-neon-hover transform hover:scale-105 transition-all duration-300">
                    Загрузить ещё
                </button>
            </div>

            <div id="empty-state" class="hidden text-center py-20">
                <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Ничего не найдено</h3>
                <p class="text-gray-400">Попробуйте изменить параметры поиска или фильтры</p>
            </div>
        </div>
    </section>

    {# About & Contact #}
    <section id="about" class="py-16 bg-white/5 text-white">
        <div class="max-w-3xl mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold mb-6">О нас</h2>
            <p class="text-gray-400 text-lg leading-relaxed">Мы отбираем лучшие товары со всего мира, чтобы вы могли наслаждаться качеством каждой покупки. Быстрая доставка, надёжная упаковка и заботливая поддержка — наш стандарт.</p>
        </div>
    </section>

    <section id="contact" class="py-16 text-white text-center">
        <div class="max-w-3xl mx-auto px-4">
            <h2 class="text-4xl font-bold mb-8">Контакты</h2>
            <p class="text-gray-400 mb-2">Есть вопросы? Напишите нам</p>
            <a href="mailto:hello@ecommerce.com" class="text-lime-400 hover:text-lime-300 transition-colors text-lg font-medium">hello@ecommerce.com</a>
        </div>
    </section>

    {# Footer #}
    <footer class="py-12 border-t border-white/5 text-center text-sm text-gray-500">
        <p>© 2026 E-commerce. Все права защищены.</p>
    </footer>

    {# Cart Sidebar #}
    <div id="cart-sidebar" class="fixed inset-y-0 right-0 w-full max-w-md frosted-glass-dark border-l border-white/10 transform translate-x-full transition-transform duration-300 z-50 text-white">
        <div class="flex flex-col h-full p-8">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl font-bold">Корзина</h2>
                <button onclick="closeCart()" class="p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div id="cart-items" class="flex-1 overflow-y-auto space-y-4">
                <p class="text-gray-500 text-center py-12">Корзина пуста</p>
            </div>
            <div id="cart-total" class="border-t border-white/10 pt-6 mt-6 hidden">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-gray-400">Итого:</span>
                    <span id="cart-total-amount" class="text-3xl font-black text-lime-500">0 ₽</span>
                </div>
                <button onclick="checkout()" class="w-full py-4 neon-button font-bold rounded-xl checkout-btn">
                    Оформить заказ
                </button>
            </div>
        </div>
    </div>

    {# Checkout Modal #}
    <div id="checkout-modal" class="fixed inset-0 modal-backdrop z-[60] hidden flex items-center justify-center p-4">
        <div class="bg-[#0f0f11] border border-white/10 rounded-3xl w-full max-w-lg p-8 text-white relative shadow-2xl transform scale-95 opacity-0 transition-all duration-300" id="checkout-modal-content">
            {# Form State #}
            <div id="checkout-form-state">
                <h2 class="text-2xl font-bold mb-2">Оформление заказа</h2>
                <p class="text-gray-400 text-sm mb-6">Заполните данные для доставки</p>

                <div id="checkout-summary" class="space-y-3 mb-6 max-h-40 overflow-y-auto pr-1"></div>
                <div class="flex justify-between items-center mb-6 border-t border-white/10 pt-4">
                    <span class="text-gray-400">К оплате:</span>
                    <span id="checkout-total" class="text-xl font-black text-lime-500">0 ₽</span>
                </div>

                <form id="order-form" onsubmit="submitOrder(event)" class="space-y-4">
                    <div>
                        <input type="email" name="customerEmail" placeholder="Email" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all">
                        <p class="text-xs text-red-400 mt-1 hidden" id="error-email">Введите корректный email</p>
                    </div>
                    <div>
                        <input type="text" name="customerName" placeholder="ФИО" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all">
                    </div>
                    <div>
                        <input type="tel" name="customerPhone" placeholder="Телефон" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all">
                        <p class="text-xs text-red-400 mt-1 hidden" id="error-phone">Введите корректный телефон</p>
                    </div>
                    <div>
                        <textarea name="deliveryAddress" placeholder="Адрес доставки" required rows="3" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all resize-none"></textarea>
                    </div>
                    <div class="flex gap-4 mt-6">
                        <button type="button" onclick="closeCheckout()" class="flex-1 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors font-medium">Отмена</button>
                        <button type="submit" id="checkout-submit-btn" class="flex-1 py-3 neon-button font-bold rounded-xl flex items-center justify-center gap-2">
                            <span>Заказать</span>
                        </button>
                    </div>
                </form>
            </div>

            {# Success State #}
            <div id="checkout-success-state" class="hidden text-center py-6">
                <div class="checkmark-circle">
                    <svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold mb-2">Заказ оформлен!</h3>
                <p class="text-gray-400 mb-6">Спасибо за покупку. Мы свяжемся с вами в ближайшее время.</p>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 mb-6">
                    <p class="text-gray-400 text-sm">Номер заказа</p>
                    <p id="success-order-number" class="text-xl font-black text-lime-500 font-mono tracking-wider">—</p>
                </div>
                <button onclick="finishCheckout()" class="w-full py-3 neon-button font-bold rounded-xl">На главную</button>
            </div>
        </div>
    </div>

    {# Toast Container #}
    <div id="toast-container" class="toast-container"></div>

    <script>
        let allProducts = [];
        let displayedProducts = 0;
        const PRODUCTS_PER_LOAD = 9;
        let cart = [];
        let activeCategory = 'all';
        let searchQuery = '';

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('cart-button').addEventListener('click', openCart);
            document.getElementById('search-input').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase();
                displayedProducts = 0;
                renderProducts();
            });
            loadProducts();
        });

        function loadMore() { showNextProducts(); }

        async function loadProducts() {
            try {
                const response = await fetch('/api/products?limit=100', { credentials: 'same-origin' });
                const result = await response.json();
                if (!result.error && result.data && result.data.products) {
                    allProducts = result.data.products;
                    buildCategoryFilters();
                    document.getElementById('products-container').innerHTML = '';
                    showNextProducts();
                } else {
                    showToast('Не удалось загрузить товары', 'error');
                }
            } catch (e) {
                showToast('Ошибка загрузки товаров', 'error');
            }
        }

        function buildCategoryFilters() {
            const container = document.getElementById('category-filters');
            const categories = new Map();
            categories.set('all', 'Все');
            allProducts.forEach(p => {
                if (p.category && p.category.name) {
                    categories.set(p.category.name, p.category.name);
                }
            });
            container.innerHTML = '';
            categories.forEach((label, key) => {
                const btn = document.createElement('button');
                btn.className = 'filter-btn px-5 py-2 rounded-full text-sm font-medium ' + (key === 'all' ? 'active' : '');
                btn.textContent = label;
                btn.dataset.category = key;
                btn.onclick = () => {
                    activeCategory = key;
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    displayedProducts = 0;
                    renderProducts();
                };
                container.appendChild(btn);
            });
        }

        function renderProducts() {
            const container = document.getElementById('products-container');
            container.innerHTML = '';
            displayedProducts = 0;
            showNextProducts();
        }

        function getFilteredProducts() {
            return allProducts.filter(p => {
                const matchesCategory = activeCategory === 'all' || (p.category && p.category.name === activeCategory);
                const matchesSearch = !searchQuery || p.name.toLowerCase().includes(searchQuery) || (p.description && p.description.toLowerCase().includes(searchQuery));
                return matchesCategory && matchesSearch;
            });
        }

        function showNextProducts() {
            const container = document.getElementById('products-container');
            const filtered = getFilteredProducts();
            const start = displayedProducts;
            const end = Math.min(start + PRODUCTS_PER_LOAD, filtered.length);

            for (let i = start; i < end; i++) {
                container.appendChild(createProductCard(filtered[i]));
            }
            displayedProducts = end;

            const loadMore = document.getElementById('load-more-container');
            if (displayedProducts < filtered.length) {
                loadMore.classList.remove('hidden');
                document.getElementById('load-more-btn').onclick = showNextProducts;
            } else {
                loadMore.classList.add('hidden');
            }

            const empty = document.getElementById('empty-state');
            if (filtered.length === 0) {
                empty.classList.remove('hidden');
            } else {
                empty.classList.add('hidden');
            }
        }

        function createProductCard(product) {
            const div = document.createElement('div');
            div.className = 'premium-card rounded-3xl p-5 overflow-hidden card-3d group animate-scale-in';
            const categoryName = product.category ? product.category.name : '';
            div.innerHTML = `
                <div class="aspect-[4/3] bg-gray-900/50 rounded-2xl mb-4 overflow-hidden relative">
                    <img src="${product.imageUrl || ''}" alt="${product.name}" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    ${categoryName ? `<span class="absolute top-3 left-3 bg-black/50 backdrop-blur-md text-xs font-medium text-white px-3 py-1 rounded-full border border-white/10">${categoryName}</span>` : ''}
                </div>
                <h3 class="font-bold text-white mb-1 text-lg leading-tight">${product.name}</h3>
                <p class="text-gray-500 text-sm mb-4 line-clamp-2">${product.description || ''}</p>
                <div class="flex justify-between items-center">
                    <span class="text-2xl font-black text-lime-500">${Math.round(product.price).toLocaleString('ru-RU')} ₽</span>
                    <button onclick="addToCart(${product.id}, '${escapeJs(product.name)}', ${product.price})" class="w-11 h-11 bg-lime-500 text-black rounded-xl flex items-center justify-center hover:bg-lime-400 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-lime-500/20">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                    </button>
                </div>
            `;
            return div;
        }

        function escapeJs(str) {
            return str.replace(/['\\]/g, '\\$&').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
        }

        function addToCart(id, name, price) {
            const existing = cart.find(i => i.productId === id);
            if (existing) existing.quantity++;
            else cart.push({ productId: id, productName: name, price, quantity: 1 });
            updateCartDisplay();
            openCart();
            showToast('Товар добавлен в корзину', 'success');
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.productId === id);
            if (!item) return;
            item.quantity += delta;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.productId !== id);
            }
            updateCartDisplay();
        }

        function removeFromCart(id) {
            cart = cart.filter(i => i.productId !== id);
            updateCartDisplay();
            showToast('Товар удалён из корзины', 'error');
        }

        function updateCartDisplay() {
            const countEl = document.getElementById('cart-count');
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            countEl.textContent = totalItems;
            countEl.style.opacity = totalItems > 0 ? '1' : '0';

            const itemsEl = document.getElementById('cart-items');
            const totalDiv = document.getElementById('cart-total');

            if (cart.length === 0) {
                itemsEl.innerHTML = `
                    <div class="text-center py-12">
                        <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                        </div>
                        <p class="text-gray-500">Корзина пуста</p>
                    </div>
                `;
                totalDiv.classList.add('hidden');
            } else {
                itemsEl.innerHTML = cart.map((item) => `
                    <div class="flex items-center justify-between bg-white/5 p-4 rounded-xl border border-white/5">
                        <div class="flex-1 min-w-0 mr-4">
                            <p class="text-sm font-medium text-white truncate">${item.productName}</p>
                            <p class="text-xs text-gray-400 mt-0.5">${Math.round(item.price).toLocaleString('ru-RU')} ₽ / шт</p>
                        </div>
                        <div class="flex items-center gap-2 mr-3">
                            <button onclick="changeQty(${item.productId}, -1)" class="qty-btn">−</button>
                            <span class="text-sm font-bold w-4 text-center">${item.quantity}</span>
                            <button onclick="changeQty(${item.productId}, 1)" class="qty-btn">+</button>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-lime-400 whitespace-nowrap">${(item.price * item.quantity).toLocaleString('ru-RU', {maximumFractionDigits:0})} ₽</span>
                            <button onclick="removeFromCart(${item.productId})" class="text-gray-500 hover:text-red-400 transition-colors p-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                `).join('');
                totalDiv.classList.remove('hidden');
                const total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
                document.getElementById('cart-total-amount').textContent = total.toLocaleString('ru-RU', {maximumFractionDigits:0}) + ' ₽';
            }
        }

        function openCart() { document.getElementById('cart-sidebar').classList.remove('translate-x-full'); }
        function closeCart() { document.getElementById('cart-sidebar').classList.add('translate-x-full'); }

        function checkout() {
            if (cart.length === 0) {
                showToast('Добавьте товары в корзину', 'error');
                return;
            }
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            const total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
            document.getElementById('checkout-total').textContent = total.toLocaleString('ru-RU', {maximumFractionDigits:0}) + ' ₽';

            const summary = document.getElementById('checkout-summary');
            summary.innerHTML = cart.map(item => `
                <div class="flex justify-between items-center text-sm bg-white/5 p-3 rounded-lg border border-white/5">
                    <span class="text-gray-300 truncate flex-1 mr-3">${item.productName} × ${item.quantity}</span>
                    <span class="font-medium text-white whitespace-nowrap">${(item.price * item.quantity).toLocaleString('ru-RU', {maximumFractionDigits:0})} ₽</span>
                </div>
            `).join('');

            document.getElementById('checkout-form-state').classList.remove('hidden');
            document.getElementById('checkout-success-state').classList.add('hidden');
            document.getElementById('order-form').reset();

            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            });
        }

        function closeCheckout() {
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function finishCheckout() {
            closeCheckout();
            closeCart();
        }

        async function submitOrder(event) {
            event.preventDefault();
            const form = event.target;
            const email = form.customerEmail.value.trim();
            const phone = form.customerPhone.value.trim();

            document.getElementById('error-email').classList.add('hidden');
            document.getElementById('error-phone').classList.add('hidden');

            const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            const phoneValid = /^[\d\+\(\)\-\s]{7,20}$/.test(phone);

            if (!emailValid) {
                document.getElementById('error-email').classList.remove('hidden');
                return;
            }
            if (!phoneValid) {
                document.getElementById('error-phone').classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('checkout-submit-btn');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<div class="spinner"></div>';

            const orderData = {
                customerEmail: email,
                customerName: form.customerName.value.trim(),
                customerPhone: phone,
                deliveryAddress: form.deliveryAddress.value.trim(),
                items: cart.map(item => ({ productId: item.productId, quantity: item.quantity }))
            };

            try {
                const response = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(orderData)
                });
                const result = await response.json();
                if (!result.error && result.data && result.data.order) {
                    document.getElementById('success-order-number').textContent = result.data.order.orderNumber;
                    document.getElementById('checkout-form-state').classList.add('hidden');
                    document.getElementById('checkout-success-state').classList.remove('hidden');
                    cart = [];
                    updateCartDisplay();
                    showToast('Заказ успешно создан!', 'success');
                } else {
                    showToast(result.message || 'Ошибка при оформлении заказа', 'error');
                }
            } catch (e) {
                showToast('Ошибка при оформлении заказа', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icon = type === 'success'
                ? `<svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`
                : `<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
            toast.innerHTML = `${icon}<span class="text-sm font-medium">${message}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('show'));
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }
    </script>
{% endblock %}
