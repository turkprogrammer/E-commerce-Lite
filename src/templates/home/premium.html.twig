{% extends 'base.html.twig' %}

{% block title %}E-commerce Premium — Коллекции{% endblock %}

{% block body %}
    {# Header #}
    <header class="fixed top-0 left-0 right-0 z-50 frosted-glass-dark border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                {# Logo #}
                <a href="/" class="flex items-center gap-3 group">
                    <div class="relative">
                        <div class="w-9 h-9 bg-lime-500 rounded-lg flex items-center justify-center transition-all duration-300 group-hover:shadow-[0_0_20px_rgba(136,255,13,0.4)]">
                            <svg class="w-5 h-5 text-black" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                            </svg>
                        </div>
                        <div class="absolute -inset-1 bg-lime-500/20 rounded-xl blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-display text-base font-bold text-white tracking-tight leading-none">ECOMMERCE</span>
                        <span class="text-[9px] font-display font-semibold tracking-[0.25em] uppercase text-lime-500/70 leading-none mt-0.5">Premium</span>
                    </div>
                </a>

                {# Nav — Pill Style #}
                <nav class="hidden md:flex items-center gap-1 p-1 rounded-full bg-white/[0.03] border border-white/[0.06]">
                    <a href="#collection" class="px-5 py-1.5 rounded-full text-xs font-display font-semibold tracking-wide text-gray-400 hover:text-white hover:bg-white/[0.06] transition-all duration-300">Каталог</a>
                    <a href="#about" class="px-5 py-1.5 rounded-full text-xs font-display font-semibold tracking-wide text-gray-400 hover:text-white hover:bg-white/[0.06] transition-all duration-300">О нас</a>
                    <a href="#contact" class="px-5 py-1.5 rounded-full text-xs font-display font-semibold tracking-wide text-gray-400 hover:text-white hover:bg-white/[0.06] transition-all duration-300">Контакты</a>
                </nav>

                {# Cart #}
                <button id="cart-button" onclick="toggleCart()" class="relative p-2.5 hover:bg-white/[0.06] rounded-xl text-white transition-all duration-300 group border border-transparent hover:border-white/10">
                    <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    <span id="cart-count" class="absolute -top-1 -right-1 bg-lime-500 text-black text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center opacity-0 transition-opacity font-display">0</span>
                </button>
            </div>
        </div>
    </header>

    {# Hero Section — Cinematic Reveal #}
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-16">
        {# Decorative diagonal line #}
        <div class="diagonal-line top-1/4 left-1/4 w-[300px]" style="opacity: 0.4"></div>
        <div class="diagonal-line bottom-1/3 right-1/4 w-[200px]" style="opacity: 0.2; transform: rotate(45deg)"></div>

        {# Geometric accent #}
        <div class="absolute top-20 right-[15%] w-24 h-24 border border-lime-500/20 rounded-full animate-pulse-slow hidden lg:block"></div>
        <div class="absolute bottom-32 left-[10%] w-16 h-16 border border-lime-500/10 rotate-45 animate-float hidden lg:block"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            {# Eyebrow #}
            <div class="animate-slide-up mb-6">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-lime-500/20 bg-lime-500/5 text-lime-400 text-xs font-display font-semibold tracking-widest uppercase">
                    <span class="w-1.5 h-1.5 bg-lime-500 rounded-full animate-pulse"></span>
                    Новая коллекция 2026
                </span>
            </div>

            {# Main Title with Glitch #}
            <h1 class="animate-slide-up mb-8" style="animation-delay: 0.1s">
                <span class="block font-display font-800 text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-[0.9] tracking-tight">
                    <span class="text-white">Define</span>
                </span>
                <span class="block font-display font-800 text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-[0.9] tracking-tight mt-2">
                    <span class="text-gradient-lime glitch-text" data-text="Your Style">Your Style</span>
                </span>
            </h1>

            {# Subtitle #}
            <p class="animate-slide-up text-gray-500 text-lg md:text-xl max-w-lg mx-auto mb-10 leading-relaxed" style="animation-delay: 0.2s">
                Curated goods from around the world.<br>
                <span class="text-gray-400">Quality you can feel.</span>
            </p>

            {# CTA Buttons #}
            <div class="animate-slide-up flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.3s">
                <a href="#collection" class="neon-button py-4 px-10 rounded-full text-base shadow-neon hover:shadow-neon-hover transform hover:scale-105 transition-all duration-300">
                    Смотреть каталог
                </a>
                <a href="#about" class="py-4 px-10 rounded-full text-base font-display font-semibold text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-300">
                    Узнать больше
                </a>
            </div>
        </div>

        {# Scroll indicator #}
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in" style="animation-delay: 1s">
            <span class="text-[10px] font-display font-semibold tracking-[0.3em] uppercase text-gray-600">Scroll</span>
            <div class="w-px h-8 bg-gradient-to-b from-lime-500/50 to-transparent"></div>
        </div>
    </section>

    {# Marquee Band — filled by JS with real categories #}
    <div id="marquee-section" class="py-4 border-y border-white/5 bg-white/[0.02] overflow-hidden">
        <div id="marquee-track" class="marquee-track justify-center">
            <span class="flex items-center gap-8 px-4 whitespace-nowrap">
                <span class="font-display font-bold text-sm tracking-[0.2em] uppercase text-gray-600">Loading...</span>
            </span>
        </div>
    </div>

    {# Filters & Search #}
    <section class="pt-16 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div id="category-filters" class="flex flex-wrap gap-2">
                    <button class="filter-btn active px-5 py-2 rounded-full text-sm font-medium" data-category="all">Все</button>
                </div>
                <div class="relative w-full md:w-72">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <input id="search-input" type="text" placeholder="Поиск товаров..." class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-gray-500 text-sm premium-input transition-all font-sans">
                </div>
            </div>
        </div>
    </section>

    {# Products #}
    <section id="collection" class="pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            {# Section header #}
            <div class="flex items-end justify-between mb-10">
                <div>
                    <h2 class="font-display font-800 text-3xl md:text-4xl text-white tracking-tight">Каталог</h2>
                    <p class="text-gray-500 text-sm mt-1">Лучшие товары, отобранные для вас</p>
                </div>
                <div class="hidden sm:flex items-center gap-2 text-xs text-gray-600 font-display">
                    <span class="w-8 h-px bg-gray-700"></span>
                    <span>SCROLL</span>
                </div>
            </div>

            <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="premium-card rounded-2xl h-96 animate-pulse"></div>
                <div class="premium-card rounded-2xl h-96 animate-pulse hidden sm:block"></div>
                <div class="premium-card rounded-2xl h-96 animate-pulse hidden lg:block"></div>
            </div>

            <div id="load-more-container" class="text-center mt-16 hidden">
                <button id="load-more-btn" class="neon-button py-4 px-10 rounded-full text-base shadow-neon hover:shadow-neon-hover transform hover:scale-105 transition-all duration-300">
                    Загрузить ещё
                </button>
            </div>

            <div id="empty-state" class="hidden text-center py-20">
                <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6 border border-white/10">
                    <svg class="w-10 h-10 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <h3 class="font-display font-bold text-xl text-white mb-2">Ничего не найдено</h3>
                <p class="text-gray-500 text-sm">Попробуйте изменить параметры поиска</p>
            </div>
        </div>
    </section>

    {# About Section — Visual Storytelling #}
    <section id="about" class="relative py-24 overflow-hidden">
        {# Background accent #}
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-lime-500/[0.02] to-transparent"></div>
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-lime-500/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-lime-500/20 to-transparent"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                {# Left: Text #}
                <div class="scroll-reveal">
                    <span class="inline-block font-display font-semibold text-xs tracking-[0.3em] uppercase text-lime-500 mb-4">О нас</span>
                    <h2 class="font-display font-800 text-4xl md:text-5xl text-white tracking-tight leading-[1.1] mb-6">
                        Мы отбираем<br>
                        <span class="text-gradient-lime">лучшее</span>
                    </h2>
                    <p class="text-gray-400 text-lg leading-relaxed mb-8">
                        Каждый товар в нашем магазине прошёл строгий отбор. Мы работаем напрямую с производителями,
                        чтобы предложить вам качество без компромисов по справедливой цене.
                    </p>
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-lime-500/10 border border-lime-500/20 flex items-center justify-center">
                            <svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-white font-semibold text-sm">Быстрая доставка</p>
                            <p class="text-gray-500 text-xs">По всей России от 1 дня</p>
                        </div>
                    </div>
                </div>

                {# Right: Stats #}
                <div class="scroll-reveal" style="transition-delay: 0.2s">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="premium-card rounded-2xl p-6 text-center group hover:border-lime-500/30">
                            <div class="stat-number text-4xl md:text-5xl text-lime-500 mb-2" data-target="1200">0</div>
                            <p class="text-gray-500 text-sm font-display">товаров</p>
                        </div>
                        <div class="premium-card rounded-2xl p-6 text-center group hover:border-lime-500/30">
                            <div class="stat-number text-4xl md:text-5xl text-lime-500 mb-2" data-target="4" id="stat-categories">0</div>
                            <p class="text-gray-500 text-sm font-display">категории</p>
                        </div>
                        <div class="premium-card rounded-2xl p-6 text-center group hover:border-lime-500/30">
                            <div class="stat-number text-4xl md:text-5xl text-lime-500 mb-2" data-target="98">0</div>
                            <p class="text-gray-500 text-sm font-display">% довольных</p>
                        </div>
                        <div class="premium-card rounded-2xl p-6 text-center group hover:border-lime-500/30">
                            <div class="stat-number text-4xl md:text-5xl text-lime-500 mb-2" data-target="24">0</div>
                            <p class="text-gray-500 text-sm font-display">часа поддержка</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Features Strip #}
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="scroll-reveal flex items-start gap-4 p-6 rounded-2xl bg-white/[0.02] border border-white/5">
                    <div class="w-10 h-10 rounded-lg bg-lime-500/10 border border-lime-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-display font-bold text-white text-sm mb-1">Бесплатная доставка</h3>
                        <p class="text-gray-500 text-xs leading-relaxed">При заказе от 5 000 ₽ по Москве и Санкт-Петербургу</p>
                    </div>
                </div>
                <div class="scroll-reveal flex items-start gap-4 p-6 rounded-2xl bg-white/[0.02] border border-white/5" style="transition-delay: 0.1s">
                    <div class="w-10 h-10 rounded-lg bg-lime-500/10 border border-lime-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-display font-bold text-white text-sm mb-1">Гарантия качества</h3>
                        <p class="text-gray-500 text-xs leading-relaxed">30 дней на возврат без вопросов</p>
                    </div>
                </div>
                <div class="scroll-reveal flex items-start gap-4 p-6 rounded-2xl bg-white/[0.02] border border-white/5" style="transition-delay: 0.2s">
                    <div class="w-10 h-10 rounded-lg bg-lime-500/10 border border-lime-500/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-display font-bold text-white text-sm mb-1">Поддержка 24/7</h3>
                        <p class="text-gray-500 text-xs leading-relaxed">Всегда на связи в чате и по телефону</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Contact Section #}
    <section id="contact" class="py-20 relative">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/[0.01] to-transparent"></div>
        <div class="max-w-2xl mx-auto px-4 text-center relative scroll-reveal">
            <span class="inline-block font-display font-semibold text-xs tracking-[0.3em] uppercase text-lime-500 mb-4">Контакты</span>
            <h2 class="font-display font-800 text-4xl md:text-5xl text-white tracking-tight mb-4">
                Свяжитесь с нами
            </h2>
            <p class="text-gray-500 text-lg mb-8">Есть вопросы? Мы всегда рады помочь</p>
            <a href="mailto:hello@ecommerce.com" class="inline-flex items-center gap-3 px-8 py-4 rounded-full border border-white/10 hover:border-lime-500/30 bg-white/[0.02] hover:bg-lime-500/5 transition-all duration-300 group">
                <svg class="w-5 h-5 text-gray-400 group-hover:text-lime-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span class="text-gray-300 group-hover:text-white transition-colors font-medium">hello@ecommerce.com</span>
            </a>
        </div>
    </section>

    {# Footer #}
    <footer class="py-8 border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <div class="w-6 h-6 bg-lime-500 rounded flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-black" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                    </div>
                    <span class="font-display font-bold text-xs tracking-tight text-gray-500">ECOMMERCE</span>
                </div>
                <p class="text-xs text-gray-600">&copy; 2026 E-commerce Premium. Все права защищены.</p>
            </div>
        </div>
    </footer>

    {# Cart Sidebar #}
    <div id="cart-sidebar" class="fixed inset-y-0 right-0 w-full max-w-md frosted-glass-dark border-l border-white/10 transform translate-x-full transition-transform duration-300 z-50 text-white">
        <div class="flex flex-col h-full p-6 md:p-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="font-display font-bold text-xl">Корзина</h2>
                <button onclick="closeCart()" class="p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div id="cart-items" class="flex-1 overflow-y-auto space-y-3">
                <div class="text-center py-16">
                    <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 border border-white/10">
                        <svg class="w-7 h-7 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    </div>
                    <p class="text-gray-600 text-sm">Корзина пуста</p>
                </div>
            </div>
            <div id="cart-total" class="border-t border-white/10 pt-6 mt-6 hidden">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-gray-400 text-sm">Итого:</span>
                    <span id="cart-total-amount" class="font-display font-800 text-2xl text-lime-500">0 ₽</span>
                </div>
                <button onclick="checkout()" class="w-full py-4 neon-button font-bold rounded-xl checkout-btn text-sm">
                    Оформить заказ
                </button>
            </div>
        </div>
    </div>

    {# Checkout Modal #}
    <div id="checkout-modal" class="fixed inset-0 modal-backdrop z-[60] hidden flex items-center justify-center p-4">
        <div class="bg-[#0f0f11] border border-white/10 rounded-2xl w-full max-w-lg p-6 md:p-8 text-white relative shadow-2xl transform scale-95 opacity-0 transition-all duration-300" id="checkout-modal-content">
            {# Form State #}
            <div id="checkout-form-state">
                <h2 class="font-display font-bold text-xl mb-1">Оформление заказа</h2>
                <p class="text-gray-500 text-sm mb-6">Заполните данные для доставки</p>

                <div id="checkout-summary" class="space-y-2 mb-6 max-h-40 overflow-y-auto pr-1"></div>
                <div class="flex justify-between items-center mb-6 border-t border-white/10 pt-4">
                    <span class="text-gray-400 text-sm">К оплате:</span>
                    <span id="checkout-total" class="font-display font-800 text-xl text-lime-500">0 ₽</span>
                </div>

                <form id="order-form" onsubmit="submitOrder(event)" class="space-y-3">
                    <div>
                        <input type="email" name="customerEmail" placeholder="Email" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all text-sm">
                        <p class="text-xs text-red-400 mt-1 hidden" id="error-email">Введите корректный email</p>
                    </div>
                    <div>
                        <input type="text" name="customerName" placeholder="ФИО" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all text-sm">
                    </div>
                    <div>
                        <input type="tel" name="customerPhone" placeholder="Телефон" required class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all text-sm">
                        <p class="text-xs text-red-400 mt-1 hidden" id="error-phone">Введите корректный телефон</p>
                    </div>
                    <div>
                        <textarea name="deliveryAddress" placeholder="Адрес доставки" required rows="2" class="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white placeholder-gray-500 premium-input transition-all resize-none text-sm"></textarea>
                    </div>
                    <div class="flex gap-3 mt-6">
                        <button type="button" onclick="closeCheckout()" class="flex-1 py-3 bg-white/5 border border-white/10 rounded-xl hover:bg-white/10 transition-colors font-display font-semibold text-sm">Отмена</button>
                        <button type="submit" id="checkout-submit-btn" class="flex-1 py-3 neon-button font-bold rounded-xl flex items-center justify-center gap-2 text-sm">
                            <span>Заказать</span>
                        </button>
                    </div>
                </form>
            </div>

            {# Success State #}
            <div id="checkout-success-state" class="hidden text-center py-6">
                <div class="checkmark-circle">
                    <svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h3 class="font-display font-bold text-xl mb-2">Заказ оформлен!</h3>
                <p class="text-gray-500 text-sm mb-6">Спасибо за покупку. Мы свяжемся с вами в ближайшее время.</p>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4 mb-6">
                    <p class="text-gray-500 text-xs mb-1">Номер заказа</p>
                    <p id="success-order-number" class="font-display font-800 text-xl text-lime-500 font-mono tracking-wider">—</p>
                </div>
                <button onclick="finishCheckout()" class="w-full py-3 neon-button font-bold rounded-xl text-sm">На главную</button>
            </div>
        </div>
    </div>

    {# Scroll to Top Button #}
    <button id="scroll-top-btn" onclick="window.scrollTo({top:0,behavior:'smooth'})" class="fixed bottom-6 left-6 z-40 w-11 h-11 rounded-full bg-white/[0.06] border border-white/10 backdrop-blur-xl text-gray-400 hover:text-lime-500 hover:border-lime-500/30 hover:bg-lime-500/10 transition-all duration-300 flex items-center justify-center opacity-0 translate-y-4 pointer-events-none">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
        </svg>
    </button>

    {# Toast Container #}
    <div id="toast-container" class="toast-container"></div>

    <script>
        let allProducts = [];
        let displayedProducts = 0;
        const PRODUCTS_PER_LOAD = 9;
        let cart = [];
        let activeCategory = 'all';
        let searchQuery = '';

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('cart-button').addEventListener('click', openCart);
            document.getElementById('search-input').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase();
                displayedProducts = 0;
                renderProducts();
            });

            // Scroll to top button
            const scrollTopBtn = document.getElementById('scroll-top-btn');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 400) {
                    scrollTopBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                    scrollTopBtn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
                } else {
                    scrollTopBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                    scrollTopBtn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
                }
            });

            loadProducts();
            initCounters();
        });

        function loadMore() { showNextProducts(); }

        async function loadProducts() {
            try {
                const response = await fetch('/api/products?limit=100', { credentials: 'same-origin' });
                const result = await response.json();
                if (!result.error && result.data && result.data.products) {
                    allProducts = result.data.products;
                    buildCategoryFilters();
                    buildMarquee();
                    updateProductCount();
                    document.getElementById('products-container').innerHTML = '';
                    showNextProducts();
                } else {
                    showToast('Не удалось загрузить товары', 'error');
                }
            } catch (e) {
                showToast('Ошибка загрузки товаров', 'error');
            }
        }

        function buildMarquee() {
            const categories = new Set();
            allProducts.forEach(p => {
                if (p.category && p.category.name) categories.add(p.category.name);
            });
            const catArr = Array.from(categories);
            if (catArr.length === 0) return;

            const items = [...catArr, 'Fast Shipping', 'Quality Guaranteed'];
            const sep = '<span class="text-lime-500">&#9670;</span>';
            const htmlItems = items.map(c => `<span class="font-display font-bold text-sm tracking-[0.2em] uppercase text-gray-600">${c}</span>`).join(sep);

            const track = document.getElementById('marquee-track');
            // Duplicate for seamless loop
            track.innerHTML = `<span class="flex items-center gap-8 px-4 whitespace-nowrap">${sep}${htmlItems}${sep}</span><span class="flex items-center gap-8 px-4 whitespace-nowrap">${sep}${htmlItems}${sep}</span>`;
        }

        function updateProductCount() {
            const productEl = document.querySelector('[data-target="1200"]');
            if (productEl) productEl.dataset.target = allProducts.length;

            const categories = new Set();
            allProducts.forEach(p => { if (p.category && p.category.name) categories.add(p.category.name); });
            const catEl = document.getElementById('stat-categories');
            if (catEl) catEl.dataset.target = categories.size;
        }

        function buildCategoryFilters() {
            const container = document.getElementById('category-filters');
            const categories = new Map();
            categories.set('all', 'Все');
            allProducts.forEach(p => {
                if (p.category && p.category.name) {
                    categories.set(p.category.name, p.category.name);
                }
            });
            container.innerHTML = '';
            categories.forEach((label, key) => {
                const btn = document.createElement('button');
                btn.className = 'filter-btn px-5 py-2 rounded-full text-sm font-medium ' + (key === 'all' ? 'active' : '');
                btn.textContent = label;
                btn.dataset.category = key;
                btn.onclick = () => {
                    activeCategory = key;
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    displayedProducts = 0;
                    renderProducts();
                };
                container.appendChild(btn);
            });
        }

        function renderProducts() {
            const container = document.getElementById('products-container');
            container.innerHTML = '';
            displayedProducts = 0;
            showNextProducts();
        }

        function getFilteredProducts() {
            return allProducts.filter(p => {
                const matchesCategory = activeCategory === 'all' || (p.category && p.category.name === activeCategory);
                const matchesSearch = !searchQuery || p.name.toLowerCase().includes(searchQuery) || (p.description && p.description.toLowerCase().includes(searchQuery));
                return matchesCategory && matchesSearch;
            });
        }

        function showNextProducts() {
            const container = document.getElementById('products-container');
            const filtered = getFilteredProducts();
            const start = displayedProducts;
            const end = Math.min(start + PRODUCTS_PER_LOAD, filtered.length);

            for (let i = start; i < end; i++) {
                container.appendChild(createProductCard(filtered[i]));
            }
            displayedProducts = end;

            const loadMore = document.getElementById('load-more-container');
            if (displayedProducts < filtered.length) {
                loadMore.classList.remove('hidden');
                document.getElementById('load-more-btn').onclick = showNextProducts;
            } else {
                loadMore.classList.add('hidden');
            }

            const empty = document.getElementById('empty-state');
            if (filtered.length === 0) {
                empty.classList.remove('hidden');
            } else {
                empty.classList.add('hidden');
            }
        }

        function createProductCard(product) {
            const div = document.createElement('div');
            div.className = 'premium-card rounded-2xl overflow-hidden card-3d group animate-scale-in';
            const categoryName = product.category ? product.category.name : '';
            const imgSrc = product.imageUrl || `https://placehold.co/600x450/1a1a1a/3f3f46?text=${encodeURIComponent(product.name)}`;
            div.innerHTML = `
                <div class="aspect-[4/3] bg-gray-900/80 overflow-hidden relative">
                    <img src="${imgSrc}" alt="${product.name}" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.src='https://placehold.co/600x450/1a1a1a/3f3f46?text=${encodeURIComponent(product.name)}'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                    ${categoryName ? `<span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md text-[10px] font-display font-semibold text-white px-3 py-1 rounded-full border border-white/10 tracking-wide uppercase">${categoryName}</span>` : ''}
                </div>
                <div class="p-5">
                    <h3 class="font-display font-bold text-white mb-1 text-base leading-tight">${product.name}</h3>
                    <p class="text-gray-600 text-xs mb-4 line-clamp-2 leading-relaxed">${product.description || ''}</p>
                    <div class="flex justify-between items-center">
                        <span class="font-display font-800 text-xl text-lime-500">${Math.round(product.price).toLocaleString('ru-RU')} <span class="text-sm font-normal text-gray-500">₽</span></span>
                        <button onclick="addToCart(${product.id}, '${escapeJs(product.name)}', ${product.price})" class="w-10 h-10 bg-lime-500 text-black rounded-xl flex items-center justify-center hover:bg-lime-400 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-lime-500/20">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        </button>
                    </div>
                </div>
            `;
            return div;
        }

        function escapeJs(str) {
            return str.replace(/['\\]/g, '\\$&').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
        }

        function addToCart(id, name, price) {
            const existing = cart.find(i => i.productId === id);
            if (existing) existing.quantity++;
            else cart.push({ productId: id, productName: name, price, quantity: 1 });
            updateCartDisplay();
            openCart();
            showToast('Товар добавлен в корзину', 'success');
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.productId === id);
            if (!item) return;
            item.quantity += delta;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.productId !== id);
            }
            updateCartDisplay();
        }

        function removeFromCart(id) {
            cart = cart.filter(i => i.productId !== id);
            updateCartDisplay();
            showToast('Товар удалён из корзины', 'error');
        }

        function updateCartDisplay() {
            const countEl = document.getElementById('cart-count');
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            countEl.textContent = totalItems;
            countEl.style.opacity = totalItems > 0 ? '1' : '0';

            const itemsEl = document.getElementById('cart-items');
            const totalDiv = document.getElementById('cart-total');

            if (cart.length === 0) {
                itemsEl.innerHTML = `
                    <div class="text-center py-16">
                        <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 border border-white/10">
                            <svg class="w-7 h-7 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                        </div>
                        <p class="text-gray-600 text-sm">Корзина пуста</p>
                    </div>
                `;
                totalDiv.classList.add('hidden');
            } else {
                itemsEl.innerHTML = cart.map((item) => `
                    <div class="flex items-center justify-between bg-white/[0.03] p-4 rounded-xl border border-white/5">
                        <div class="flex-1 min-w-0 mr-4">
                            <p class="text-sm font-medium text-white truncate">${item.productName}</p>
                            <p class="text-xs text-gray-500 mt-0.5">${Math.round(item.price).toLocaleString('ru-RU')} ₽ / шт</p>
                        </div>
                        <div class="flex items-center gap-2 mr-3">
                            <button onclick="changeQty(${item.productId}, -1)" class="qty-btn">−</button>
                            <span class="text-sm font-bold w-4 text-center font-display">${item.quantity}</span>
                            <button onclick="changeQty(${item.productId}, 1)" class="qty-btn">+</button>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-display font-bold text-lime-400 whitespace-nowrap text-sm">${(item.price * item.quantity).toLocaleString('ru-RU', {maximumFractionDigits:0})} ₽</span>
                            <button onclick="removeFromCart(${item.productId})" class="text-gray-600 hover:text-red-400 transition-colors p-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                `).join('');
                totalDiv.classList.remove('hidden');
                const total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
                document.getElementById('cart-total-amount').textContent = total.toLocaleString('ru-RU', {maximumFractionDigits:0}) + ' ₽';
            }
        }

        function openCart() { document.getElementById('cart-sidebar').classList.remove('translate-x-full'); }
        function closeCart() { document.getElementById('cart-sidebar').classList.add('translate-x-full'); }

        function checkout() {
            if (cart.length === 0) {
                showToast('Добавьте товары в корзину', 'error');
                return;
            }
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            const total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
            document.getElementById('checkout-total').textContent = total.toLocaleString('ru-RU', {maximumFractionDigits:0}) + ' ₽';

            const summary = document.getElementById('checkout-summary');
            summary.innerHTML = cart.map(item => `
                <div class="flex justify-between items-center text-sm bg-white/[0.03] p-3 rounded-lg border border-white/5">
                    <span class="text-gray-300 truncate flex-1 mr-3">${item.productName} × ${item.quantity}</span>
                    <span class="font-medium text-white whitespace-nowrap">${(item.price * item.quantity).toLocaleString('ru-RU', {maximumFractionDigits:0})} ₽</span>
                </div>
            `).join('');

            document.getElementById('checkout-form-state').classList.remove('hidden');
            document.getElementById('checkout-success-state').classList.add('hidden');
            document.getElementById('order-form').reset();

            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            });
        }

        function closeCheckout() {
            const modal = document.getElementById('checkout-modal');
            const content = document.getElementById('checkout-modal-content');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function finishCheckout() {
            closeCheckout();
            closeCart();
        }

        async function submitOrder(event) {
            event.preventDefault();
            const form = event.target;
            const email = form.customerEmail.value.trim();
            const phone = form.customerPhone.value.trim();

            document.getElementById('error-email').classList.add('hidden');
            document.getElementById('error-phone').classList.add('hidden');

            const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            const phoneValid = /^[\d\+\(\)\-\s]{7,20}$/.test(phone);

            if (!emailValid) {
                document.getElementById('error-email').classList.remove('hidden');
                return;
            }
            if (!phoneValid) {
                document.getElementById('error-phone').classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('checkout-submit-btn');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<div class="spinner"></div>';

            const orderData = {
                customerEmail: email,
                customerName: form.customerName.value.trim(),
                customerPhone: phone,
                deliveryAddress: form.deliveryAddress.value.trim(),
                items: cart.map(item => ({ productId: item.productId, quantity: item.quantity }))
            };

            try {
                const response = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(orderData)
                });
                const result = await response.json();
                if (!result.error && result.data && result.data.order) {
                    document.getElementById('success-order-number').textContent = result.data.order.orderNumber;
                    document.getElementById('checkout-form-state').classList.add('hidden');
                    document.getElementById('checkout-success-state').classList.remove('hidden');
                    cart = [];
                    updateCartDisplay();
                    showToast('Заказ успешно создан!', 'success');
                } else {
                    showToast(result.message || 'Ошибка при оформлении заказа', 'error');
                }
            } catch (e) {
                showToast('Ошибка при оформлении заказа', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icon = type === 'success'
                ? `<svg class="w-5 h-5 text-lime-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`
                : `<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
            toast.innerHTML = `${icon}<span class="text-sm font-medium">${message}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('show'));
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }

        // Animated counters for stats section
        function initCounters() {
            const counterObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const el = entry.target;
                        const target = parseInt(el.dataset.target);
                        animateCounter(el, target);
                        counterObserver.unobserve(el);
                    }
                });
            }, { threshold: 0.5 });

            document.querySelectorAll('.stat-number').forEach(el => counterObserver.observe(el));
        }

        function animateCounter(el, target) {
            const duration = 2000;
            const start = performance.now();
            const suffix = el.parentElement.querySelector('p').textContent.includes('%') ? '' : '';

            function update(now) {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(eased * target);
                el.textContent = current.toLocaleString('ru-RU') + suffix;
                if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
        }
    </script>
{% endblock %}
