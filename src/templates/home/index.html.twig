<script>
// Состояние каталога товаров
let allProducts = [];
let displayedProducts = 0;
const productsPerPage = 4;
let cart = [];

// Загрузка товаров при загрузке страницы
document.addEventListener('DOMContentLoaded', function() {
    loadProducts();
    updateCartDisplay();
});

// Загрузка товаров из API
async function loadProducts() {
    try {
        console.log('🔄 Загрузка товаров...');
        const response = await fetch('/api/products?limit=100');
        const data = await response.json();
        
        console.log('📦 Получено товаров:', data.data?.total || 0);

        if (!data.error && data.data) {
            allProducts = data.data.products || [];
            displayedProducts = 0;
            
            // Очищаем skeleton loader перед загрузкой
            const container = document.getElementById('products-container');
            container.innerHTML = '';
            
            console.log('✅ Загружено', allProducts.length, 'товаров');
            showNextProducts();
        } else {
            console.error('❌ Ошибка API:', data);
            showError();
        }
    } catch (error) {
        console.error('💥 Ошибка загрузки товаров:', error);
        showError();
    }
}

// Показать следующие товары
function showNextProducts() {
    const container = document.getElementById('products-container');
    const start = displayedProducts;
    const end = Math.min(start + productsPerPage, allProducts.length);
    
    console.log('📄 Показываем товары с', start, 'по', end, 'из', allProducts.length);
    
    // Если товаров нет
    if (allProducts.length === 0) {
        container.innerHTML = '<p class="col-span-full text-center text-gray-600 text-lg">Товары не найдены</p>';
        document.getElementById('load-more-container').classList.add('hidden');
        return;
    }
    
    // Если все товары уже показаны
    if (start >= allProducts.length) {
        document.getElementById('load-more-container').classList.add('hidden');
        document.getElementById('all-loaded').classList.remove('hidden');
        return;
    }

    const productsToDisplay = allProducts.slice(start, end);
    console.log('🎯 Показываем', productsToDisplay.length, 'товаров');
    
    productsToDisplay.forEach((product, index) => {
        const productCard = createProductCard(product, start + index);
        container.appendChild(productCard);
        
        // Анимация появления
        setTimeout(() => {
            productCard.classList.remove('opacity-0');
            productCard.classList.add('animate-slide-up');
        }, index * 100);
    });

    displayedProducts = end;
    console.log('✅ Показано товаров:', displayedProducts, 'из', allProducts.length);

    // Показываем кнопку "Показать еще" если есть товары
    if (displayedProducts < allProducts.length) {
        document.getElementById('load-more-container').classList.remove('hidden');
        document.getElementById('all-loaded').classList.add('hidden');
    } else {
        setTimeout(() => {
            document.getElementById('load-more-container').classList.add('hidden');
            document.getElementById('all-loaded').classList.remove('hidden');
        }, 500);
    }
}

// Создание карточки товара
function createProductCard(product, index) {
    const div = document.createElement('div');
    div.className = 'premium-card rounded-3xl overflow-hidden card-3d opacity-0 transition-all duration-500';

    const discount = product.oldPrice && product.oldPrice > product.price
        ? Math.round(((product.oldPrice - product.price) / product.oldPrice) * 100)
        : 0;

    div.innerHTML = `
        <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
            ${product.imageUrl ? `
                <img src="${product.imageUrl}" alt="${product.name}"
                     class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                     loading="lazy"
                     onerror="this.onerror=null; this.src='data:image/svg+xml;base64,'">
            ` : `
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100">
                    <svg class="w-20 h-20 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
            `}

            ${product.featured ? `
                <span class="absolute top-3 left-3 bg-gradient-to-r from-amber-400 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg glow">
                    🔥 ХИТ
                </span>
            ` : ''}

            ${discount > 0 ? `
                <span class="absolute top-3 right-3 bg-gradient-to-r from-red-500 to-pink-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-lg">
                    -${discount}%
                </span>
            ` : ''}
        </div>

        <div class="p-5">
            <h3 class="font-bold text-lg mb-2 line-clamp-2 text-gray-900">${product.name}</h3>
            ${product.category ? `
                <p class="text-xs text-gray-500 mb-2 flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                    ${product.category.name}
                </p>
            ` : ''}
            <p class="text-gray-600 text-sm mb-4 line-clamp-2">${product.description || 'Описание отсутствует'}</p>

            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-baseline space-x-2">
                        <span class="text-2xl font-black text-primary-600">${product.price.toFixed(2)} ₽</span>
                        ${product.oldPrice ? `
                            <span class="text-sm text-gray-400 line-through">${product.oldPrice.toFixed(2)} ₽</span>
                        ` : ''}
                    </div>
                </div>
                <button onclick="addToCart(${product.id}, '${product.name.replace(/'/g, "\\'")}', ${product.price})"
                        class="neon-button text-gray-900 p-3 rounded-xl hover:opacity-90 transition-all transform hover:scale-110 shadow-lg hover:shadow-xl">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                </button>
            </div>
        </div>
    `;

    return div;
}

// Показать ошибку
function showError() {
    document.getElementById('products-container').innerHTML = `
        <div class="col-span-full text-center py-12 animate-fade-in">
            <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <p class="text-gray-600 text-lg mb-4">Не удалось загрузить товары</p>
            <button onclick="loadProducts()" class="btn-gradient text-white font-bold py-3 px-6 rounded-full shadow-lg inline-flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                <span>Попробовать снова</span>
            </button>
        </div>
    `;
    document.getElementById('load-more-container').classList.add('hidden');
}

// Добавить в корзину
function addToCart(productId, productName, price) {
    const existingItem = cart.find(item => item.productId === productId);

    if (existingItem) {
        existingItem.quantity++;
    } else {
        cart.push({ productId, productName, price, quantity: 1 });
    }

    updateCartDisplay();
    showNotification('Товар добавлен в корзину! 🎉');
}

// Обработчик кнопки "Показать еще"
document.addEventListener('DOMContentLoaded', function() {
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
            // Анимация кнопки при нажатии
            this.classList.add('scale-95');
            setTimeout(() => {
                this.classList.remove('scale-95');
                showNextProducts();
            }, 150);
        });
    }
});

// Обновить отображение корзины
function updateCartDisplay() {
    const countElement = document.getElementById('cart-count');
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    countElement.textContent = totalItems;
    countElement.style.opacity = totalItems > 0 ? '1' : '0';
    
    // Обновляем содержимое модального окна
    updateCartModal();
}

// Обновить модальное окно корзины
function updateCartModal() {
    const cartItemsContainer = document.getElementById('cart-items');
    const cartTotalDiv = document.getElementById('cart-total');
    
    if (cart.length === 0) {
        cartItemsContainer.innerHTML = '<p class="text-center text-gray-500 mt-8">Корзина пуста</p>';
        cartTotalDiv.classList.add('hidden');
        return;
    }
    
    cartTotalDiv.classList.remove('hidden');
    document.getElementById('cart-total-amount').textContent = cartTotal.toFixed(2) + ' ₽';
    
    cartItemsContainer.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between mb-4 pb-4 border-b">
            <div class="flex-1">
                <h4 class="font-medium">${item.productName}</h4>
                <p class="text-sm text-gray-600">${item.price.toFixed(2)} ₽ x ${item.quantity}</p>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="updateQuantity(${item.productId}, ${item.quantity - 1})" 
                        class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                    </svg>
                </button>
                <span class="font-medium">${item.quantity}</span>
                <button onclick="updateQuantity(${item.productId}, ${item.quantity + 1})" 
                        class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                </button>
                <button onclick="removeFromCart(${item.productId})" class="text-red-500 hover:text-red-700 ml-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    `).join('');
}

// Обновить количество
function updateQuantity(productId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(productId);
        return;
    }
    
    const item = cart.find(item => item.productId === productId);
    if (item) {
        item.quantity = newQuantity;
        updateCartDisplay();
    }
}

// Удалить из корзины
function removeFromCart(productId) {
    cart = cart.filter(item => item.productId !== productId);
    updateCartDisplay();
}

// Открыть корзину
function openCart() {
    const modal = document.getElementById('cart-modal');
    const panel = modal.querySelector('div > div');
    modal.classList.remove('hidden');
    setTimeout(() => {
        panel.classList.remove('translate-x-full');
    }, 10);
}

// Закрыть корзину
function closeCart() {
    const modal = document.getElementById('cart-modal');
    const panel = modal.querySelector('div > div');
    panel.classList.add('translate-x-full');
    setTimeout(() => {
        modal.classList.add('hidden');
    }, 300);
}

// Оформление заказа
function checkout() {
    if (cart.length === 0) {
        showNotification('Корзина пуста!', 'error');
        return;
    }
    
    // Здесь будет интеграция с API заказов
    showNotification('Переход к оформлению заказа...');
    console.log('Заказ:', { items: cart, total: cartTotal });
}

// Уведомления
function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full ${
        type === 'success' ? 'bg-green-500' : 'bg-red-500'
    } text-white`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.remove('translate-x-full');
    }, 100);
    
    setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// Обработчики событий
document.getElementById('cart-button').addEventListener('click', openCart);
</script>
{% endblock %}